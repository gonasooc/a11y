# 서버/로컬 분석용. 실제 키는 .env에 저장하고 Git에 올리지 않습니다.
# API별 활용신청은 docs/digital-inclusion/analysis.md의 부록 B 참고.
# KOSIS 장애인현황·열린재정 키는 analyses/media-access/README.md 참고.

# 조달청: 나라장터쇼핑몰 품목정보 서비스 (15129471)
# 공공데이터포털 Decoding 인증키
PPS_SHOPPING_MALL_SERVICE_KEY=

# 행정안전부: 무인민원발급기정보 조회서비스 (15154774)
# 공공데이터포털 Decoding 인증키
MOIS_KIOSK_INFO_SERVICE_KEY=

# KOSIS: 디지털정보격차 통계표 조회
# KOSIS 공유서비스에서 발급받은 인증키
KOSIS_DIGITAL_DIVIDE_API_KEY=

# KOSIS: 보건복지부 장애인현황(등록장애인) 통계표 조회
# KOSIS 공유서비스 인증키. 키는 통계표가 아니라 사용자 단위라 KOSIS_DIGITAL_DIVIDE_API_KEY와 같은 값을 넣는다
KOSIS_DISABILITY_API_KEY=

# 열린재정(openfiscaldata.go.kr): 세부사업 예산 조회(TotalExpenditure5 등)
# 열린재정에서 발급받은 인증키. 공공데이터포털 키가 아니다
OPENFISCAL_BUDGET_API_KEY=
